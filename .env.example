# Smart Classroom environment variables
# Copy this file to .env.local and fill in the values.
# Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
LLM_MODEL_GEN=openai/gpt-oss-120b
LLM_MODEL_GRADING=openai/gpt-oss-120b
LLM_MODEL_CHAT=openai/gpt-oss-120b
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Local development only: points the Inngest SDK at http://localhost:8288.
# Do not set this in production.
INNGEST_DEV=1
